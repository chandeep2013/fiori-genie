# Copy to .env and fill in one provider.
# With no key set, fiori-genie uses the offline "demo" provider automatically.

# --- Option 0: offline demo (default when no key is set) ---
# FIORI_GENIE_PROVIDER=demo

# --- Option 1: Google AI Studio / Gemini (recommended free tier) ---
# Get a key at https://aistudio.google.com/apikey  (no paid OpenAI account needed)
# GEMINI_API_KEY=...
# FIORI_GENIE_PROVIDER=gemini
# FIORI_GENIE_MODEL=gemini-flash-latest
# Alternatives if rate-limited: gemini-2.0-flash, gemini-3.5-flash
# Raise if JSON comes back truncated mid-string (default 65536):
# FIORI_GENIE_MAX_OUTPUT_TOKENS=65536
# --- Option 2: Anthropic ---
# Get a key at https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...
# FIORI_GENIE_PROVIDER=anthropic
# FIORI_GENIE_MODEL=claude-sonnet-4-5

# --- Option 3: OpenAI ---
# Get a key at https://platform.openai.com/api-keys (needs billing credits)
# OPENAI_API_KEY=sk-...
# FIORI_GENIE_PROVIDER=openai
# FIORI_GENIE_MODEL=gpt-4.1

# --- Option 4: SAP Generative AI Hub on AI Core ---
# Keeps prompts inside your BTP subaccount. Not verified against a live tenant yet.
# FIORI_GENIE_PROVIDER=genai-hub
# FIORI_GENIE_MODEL=anthropic--claude-4-sonnet
# AICORE_CLIENT_ID=
# AICORE_CLIENT_SECRET=
# AICORE_AUTH_URL=
# AICORE_BASE_URL=
# AICORE_RESOURCE_GROUP=default

# Path to a cds executable, if not using the one in this repo's node_modules.
# FIORI_GENIE_CDS=/usr/local/bin/cds
