# Copy to .env and fill in one provider.
# With no key set, fiori-genie uses the offline "demo" provider automatically
# (returns the sample purchase-requisition model — good for demos, not real specs).

# --- Option 0: offline demo (default when no key is set) ---
# FIORI_GENIE_PROVIDER=demo

# --- Option 1: Anthropic (recommended for real specs) ---
# Get a key at https://console.anthropic.com/settings/keys (free credits on signup)
# ANTHROPIC_API_KEY=sk-ant-...
# FIORI_GENIE_MODEL=claude-sonnet-4-5

# --- Option 2: OpenAI ---
# Get a key at https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...
# FIORI_GENIE_MODEL=gpt-4.1

# --- Option 3: SAP Generative AI Hub on AI Core ---
# Keeps prompts inside your BTP subaccount. The provider is written but has not
# been verified against a live AI Core tenant; expect to adjust it.
# FIORI_GENIE_PROVIDER=genai-hub
# FIORI_GENIE_MODEL=anthropic--claude-4-sonnet
# AICORE_CLIENT_ID=
# AICORE_CLIENT_SECRET=
# AICORE_AUTH_URL=
# AICORE_BASE_URL=
# AICORE_RESOURCE_GROUP=default

# Override which provider is used when several credentials are present.
# FIORI_GENIE_PROVIDER=demo

# Path to a cds executable, if not using the one in this repo's node_modules.
# FIORI_GENIE_CDS=/usr/local/bin/cds
