namespace {{ model.namespace }};

using { cuid, managed } from '@sap/cds/common';
{% for entity in model.entities %}

{% if entity.doc %}
/**
 * {{ entity.doc }}
 */
{% endif %}
{% if entity.label %}
@title: '{{ entity.label | cds_str }}'
{% endif %}
entity {{ entity.name }}{{ aspects(entity) }} {
{% for field in entity.fields %}
{% if field.doc %}
  // {{ field.doc }}
{% endif %}
{% if field.label %}
  @title: '{{ field.label | cds_str }}'
{% endif %}
  {{ field_decl(field) }}
{% endfor %}
{% for rel in entity.relations %}
{% if rel.label %}
  @title: '{{ rel.label | cds_str }}'
{% endif %}
  {{ relation_decl(rel) }}
{% endfor %}
}
{% endfor %}
